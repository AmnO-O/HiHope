{
  "mode": "train80",
  "backbone": "jhu-clsp/mmBERT-base",
  "model_backend": "twostream",
  "proto_stream": true,
  "proto_rank_loss": 0.15,
  "proto_margin": 0.2,
  "fusion_type": "cross_attention",
  "fusion_layers": 1,
  "fusion_heads": 4,
  "extract_layers": [14, 15, 16, 17, 18],
  "target_mask_prob": 0.25,
  "train_aux": [],
  "max_context_length": 256,
  "dropout": 0.5,

  "freeze_epochs": 30,
  "lora_epochs": 0,
  "lora_targets": [],
  "lora_rank": 0,

  "batch_size": 64,
  "accum_steps": 1,
  "num_workers": 0,
  "head_lr": 1e-4,
  "encoder_lr": 0.0,
  "embedding_lr": 0.0,
  "weight_decay": 0.05,
  "grad_clip": 1.0,
  "amp_init_scale": 1024.0,
  "amp_growth_interval": 256,
  "patience": 8,
  "ema_decay": 0.999,
  "ccc_weight": 0.6,
  "ccc_var_floor": 0.05,
  "bin_sigma": 0.5,
  "use_label_std": true,
  "test_size": 0.2,
  "seed": 42
}

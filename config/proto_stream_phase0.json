{
  "mode": "train80",
  "model_backend": "twostream",
  "backbone": "jhu-clsp/mmBERT-base",
  "hidden_size": 768,
  "head_hidden": 128,
  "batch_size": 32,
  "accum_steps": 1,
  "head_lr": 0.0003,
  "encoder_lr": 0.0,
  "freeze_epochs": 20,
  "lora_epochs": 0,
  "lora_targets": [],
  "patience": 6,
  "targets": ["mod", "head", "pv"],
  "proto_stream": true,
  "proto_mode": "hybrid",
  "use_adaptive_gate": true,
  "use_wep_infonce": true,
  "wep_tau": 0.10,
  "wep_weight": 1.0,
  "phase0_only": true,
  "supervised_loss_weight": 0.0,
  "proto_rank_loss": 0.0,
  "ccc_loss_weight": 0.0,
  "use_ema": true,
  "ema_decay": 0.999
}

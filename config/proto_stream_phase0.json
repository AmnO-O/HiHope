{
  "mode": "train80",
  "model_backend": "twostream",
  "backbone": "jhu-clsp/mmBERT-base",
  "hidden_size": 768,
  "head_hidden": 128,
  "batch_size": 32,
  "accum_steps": 1,
  "head_lr": 0.0003,
  "encoder_lr": 0.000008,
  "freeze_epochs": 2,
  "lora_epochs": 18,
  "lora_targets": ["Wqkv", "Wo", "q_proj", "k_proj", "v_proj", "o_proj"],
  "lora_from_layer": 18,
  "lora_rank": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "patience": 6,
  "targets": ["mod", "head", "pv"],
  "proto_stream": true,
  "proto_mode": "hybrid",
  "use_adaptive_gate": true,
  "use_wep_infonce": true,
  "wep_tau": 0.10,
  "wep_weight": 1.0,
  "phase0_only": true,
  "supervised_loss_weight": 0.0,
  "proto_rank_loss": 0.0,
  "ccc_weight": 0.0,
  "ema_decay": 0.999
}

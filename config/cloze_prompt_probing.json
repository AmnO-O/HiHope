{
  "_comment": "Cloze-Prompt Masked Probing Architecture with Semantic Routing & Multi-Layer Extraction",
  "mode": "train80",
  "backbone": "jhu-clsp/mmBERT-base",
  "model_backend": "cloze",
  "extract_layers": [6, 14, 20],
  "use_verbalizer_prior": true,
  "max_length": 256,
  "train_aux": [
    "en-comp-aux.tsv",
    "de-litnlit-aux.tsv",
    "en-ijcnlp-aux.tsv",
    "nctti_en_scored.tsv"
  ],
  "aux_loss_weight": 0.25,
  "dropout": 0.2,
  "freeze_epochs": 10,
  "lora_epochs": 20,
  "lora_targets": ["q_proj", "v_proj"],
  "lora_rank": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_from_layer": 12,
  "batch_size": 64,
  "accum_steps": 2,
  "num_workers": 0,
  "head_lr": 2e-4,
  "head_lr_schedule": "cosine",
  "head_lr_min_ratio": 0.1,
  "warmup_ratio": 0.05,
  "encoder_lr": 1e-5,
  "weight_decay": 0.05,
  "grad_clip": 1.0,
  "patience": 10,
  "ema_decay": 0.999,
  "kl_weight": 1.0,
  "ccc_weight": 0.8,
  "ccc_var_floor": 0.05,
  "test_size": 0.2,
  "seed": 42
}

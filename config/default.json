{
  "mode": "train80",
  "seed": 42,
  "backbone": "jhu-clsp/mmBERT-base",
  "hidden_size": 768,
  "model_backend": "query_attention",
  "head_hidden": 128,
  "dropout": 0.1,
  "num_roles": 4,
  "num_cross_heads": 8,
  "num_self_heads": 4,
  "shared_head": true,
  "sigma_floor": 0.04,
  "use_pre_ln": true,
  "use_rms_norm": true,
  "max_context_length": 256,
  "en_nn_train": "en-nn-train.tsv",
  "de_nn_train": "de-nn-train.tsv",
  "en_pv_train": "en-pv-train.tsv",
  "de_pv_train": "de-pv-train.tsv",
  "en_nn_trial": "en-nn-trial.tsv",
  "de_nn_trial": "de-nn-trial.tsv",
  "en_pv_trial": "en-pv-trial.tsv",
  "de_pv_trial": "de-pv-trial.tsv",
  "freeze_epochs": 3,
  "unfreeze_epochs": 9,
  "targets": ["mod", "head", "pv"],
  "batch_size": 16,
  "eval_batch_size": 32,
  "gradient_accumulation_steps": 1,
  "lr_heads": 0.0003,
  "lr_backbone": 0.00002,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "warmup_ratio": 0.1,
  "fp16": true,
  "ccc_weight": 0.7,
  "ccc_var_floor": 0.05,
  "bin_sigma": 0.5,
  "use_label_std": true,
  "kl_weight": 1.0
}

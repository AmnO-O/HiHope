{
  "_comment": "Full Extended Frozen-Backbone Training Config with Decoupled Heads and Balanced Auxiliaries",
  "mode": "train80",
  "backbone": "jhu-clsp/mmBERT-base",
  "model_backend": "twostream",

  "proto_stream": true,
  "proto_mode": "template",
  "max_proto_length": 32,
  "proto_rank_loss": 0.15,
  "proto_margin": 0.2,

  "fusion_type": "cross_attention",
  "fusion_layers": 2,
  "fusion_heads": 4,
  "extract_layers": [14, 15, 16, 17, 18],
  "extract_mode": "mean",

  "target_mask_prob": 0.0,
  "train_aux": [
    "en-comp-aux.tsv",
    "de-litnlit-aux.tsv",
    "en-ijcnlp-aux.tsv",
    "nctti_en_scored.tsv"
  ],
  "aux_loss_weight": 0.25,
  "max_context_length": 256,
  "dropout": 0.3,

  "freeze_epochs": 60,
  "lora_epochs": 0,
  "lora_targets": [],
  "lora_rank": 0,

  "batch_size": 128,
  "accum_steps": 1,
  "num_workers": 0,
  "head_lr": 1e-4,
  "head_lr_schedule": "constant",
  "head_lr_min_ratio": 0.1,
  "warmup_ratio": 0.0,
  "encoder_lr": 0.0,
  "embedding_lr": 0.0,
  "weight_decay": 0.05,
  "grad_clip": 1.0,
  "amp_init_scale": 1024.0,
  "amp_growth_interval": 256,
  "patience": 12,
  "ema_decay": 0.999,

  "kl_weight": 1.0,
  "ccc_weight": 0.8,
  "ccc_var_floor": 0.05,
  "bin_sigma": 0.5,
  "use_label_std": true,
  "test_size": 0.2,
  "seed": 722006
}

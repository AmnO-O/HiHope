{
  "mode": "train80",
  "model_backend": "twostream",
  "backbone": "jhu-clsp/mmBERT-base",
  "hidden_size": 768,
  "head_hidden": 128,
  "batch_size": 32,
  "accum_steps": 1,
  "head_lr": 0.0001,
  "encoder_lr": 0.000008,
  "freeze_epochs": 15,
  "lora_epochs": 25,
  "lora_targets": ["q_proj", "v_proj", "attn.Wqkv", "attn.Wo"],
  "patience": 6,
  "targets": ["mod", "head", "pv"],
  "proto_stream": true,
  "proto_mode": "hybrid",
  "use_adaptive_gate": true,
  "use_wep_infonce": true,
  "wep_tau": 0.10,
  "wep_weight": 0.08,
  "phase0_only": false,
  "supervised_loss_weight": 1.0,
  "proto_rank_loss": 0.0,
  "ema_decay": 0.999,
  "load_from": "models/best.pt"
}

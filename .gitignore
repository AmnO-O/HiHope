# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Notebooks
.ipynb_checkpoints/

# Data (mounted separately on Kaggle via the Compartment dataset input)
dataset/*
trial/

# Upstream NCTTI repo clone (ukWaC-derived sentences; do not redistribute).
# Only the BUILT aux file dataset/nctti_en.tsv is committed; regenerate with
# tools/build_nctti_aux.py.
nctti/

# Cordeiro et al. 2019 lemma-level compositionality dataset (EN/FR/PT).
# Downloaded for reference only; not part of the competition data or pipeline.
comp-datasets-release-v2/

# Koeper & Schulte im Walde 2016 (NAACL-HLT) German particle-verb literalness
# resource. Local reference clone; the BUILT aux file dataset/de-litnlit-aux.tsv
# is generated by tools/build_litnlit_aux.py and stays under dataset/* (ignored).
pv_litnlit/

# Other local reference dataset clones (do not redistribute / not part of the
# pipeline). Any BUILT aux file is regenerated by tools/*.py into dataset/*.
CLLSfinalrelease/
ijcnlp_compositionality_data/

# McCarthy/Keller/Carroll 2003 phrasal-verb compositionality gold standard:
# verb-level scores ONLY (no context sentences), so it cannot feed the
# pipeline. Reference / scale-sanity check only.
McCarthyGS/

# ComposiGen (LREC-2026) noun-noun compositionality: compound-level modifier/head
# ratings WITHOUT context sentences -> cannot feed the pipeline. Strong NN-scale
# validator (Spearman 0.72 mod / 0.60 head on the 157 overlapping compounds).
ComposiGen/

# Run artifacts
output/
*.pt
run.log

# OS
.DS_Store
Thumbs.db